# Usado pelo docker-compose.yml. Copie para .env e ajuste antes de rodar
# "docker compose up".

# Gere um valor aleatório longo, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta exposta no host (o container sempre escuta em 4000 internamente)
PORT=4000

# true somente se o self-hosted estiver atrás de HTTPS (reverse proxy com TLS)
COOKIE_SECURE=false

# Necessário só para "docker compose --profile https up" (ver README.md).
# Domínio público apontando para este servidor — ex.: um subdomínio grátis
# do DuckDNS (seunome.duckdns.org) se você não tiver domínio próprio e/ou
# tiver IP dinâmico. O Caddy usa isso para emitir o certificado HTTPS.
# DOMAIN=seunome.duckdns.org
