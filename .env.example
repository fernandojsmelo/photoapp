# Usado pelo docker-compose.yml. Copie para .env e ajuste antes de rodar
# "docker compose up".

# Gere um valor aleatório longo, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta exposta no host (o container sempre escuta em 4000 internamente)
PORT=4000

# true somente se o self-hosted estiver atrás de HTTPS (reverse proxy com TLS)
COOKIE_SECURE=false
